# Copy to .env for local development. In deployment, set these as real environment variables.

ENVIRONMENT=development          # "production" refuses to start with the default SECRET_KEY
SECRET_KEY=change-me-to-a-long-random-string   # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite (default): file-based, good for one laptop. Back up the file.
DATABASE_URL=sqlite:///./data/gym.db
# Postgres later (also add psycopg to requirements.txt):
# DATABASE_URL=postgresql+psycopg://gym:password@localhost:5432/gym

# Folder of static frontend files served by the backend (default: ../frontend). Empty = API only.
# FRONTEND_DIR=../frontend

# Only needed if the frontend is served from a different origin than the API.
# CORS_ORIGINS=https://gym.example.com
